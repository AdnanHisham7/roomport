# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/rental-platform

# JWT
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_AGREEMENT_SECRET=change_this_agreement_secret

# Password Reset
PASSWORD_RESET_EXPIRES_MINUTES=15

# Email (Resend is recommended for cloud hosting like Render; SMTP fallback is supported)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=RoomPort
APP_NAME=RoomPort

# Email (SMTP fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# App — must match the frontend origin (used for CORS)
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Stripe — used for subscription checkout (builder billing)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Razorpay — used for optional online booking payments and refunds
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Tenant Portal — separate JWT secret from the admin JWT_ACCESS_SECRET,
JWT_TENANT_PORTAL_SECRET=change_this_tenant_portal_secret
TENANT_PORTAL_SETUP_EXPIRES_IN=24h
TENANT_PORTAL_SESSION_EXPIRES_IN=7d

# Redis — used for OTP storage
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Twilio — optional, used for SMS notifications (rent reminders etc.)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

CLOUDINARY_CLOUD_NAME=xxxxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxx